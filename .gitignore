# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# rsvp database, guest photos, and server update bookkeeping
/data/*.sqlite
/data/*.sqlite-*
/data/photos/
/data/deploy-branch
/data/update-status.json
/data/update.log
/data/update.lock

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
